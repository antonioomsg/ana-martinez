[{"id":23,"date":"2014-07-29T07:20:45","date_gmt":"2014-07-29T07:20:45","guid":{"rendered":"http:\/\/www.ana-martinez.com\/en\/?page_id=23"},"modified":"2025-09-04T10:02:26","modified_gmt":"2025-09-04T08:02:26","slug":"contact","status":"publish","type":"page","link":"https:\/\/www.ana-martinez.com\/en\/contact\/","title":{"rendered":"CONTACT"},"content":{"rendered":"<div style=\"margin: 0px 0px 10px 0px\"><a href=\"mailto:ana@ana-martinez.com\"><img decoding=\"async\" class=\"ssba\" title=\"Email\" src=\"\/ana-martinez\/wp-content\/plugins\/simple-share-buttons-adder\/buttons\/somacro\/email.png\" alt=\"Email\" width=\"24px\" height=\"24px\" \/>\u00a0ana@ana-martinez.com<\/a><\/div>\n<div style=\"margin: 0px 0px 10px 0px\"><\/div>\n<div style=\"margin: 0px 0px 10px 0px\"><\/div>\n","protected":false},"excerpt":{"rendered":"<p>\u00a0ana@ana-martinez.com<\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"open","template":"","meta":{"_monsterinsights_skip_tracking":false,"footnotes":""},"_links":{"self":[{"href":"https:\/\/www.ana-martinez.com\/en\/wp-json\/wp\/v2\/pages\/23"}],"collection":[{"href":"https:\/\/www.ana-martinez.com\/en\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/www.ana-martinez.com\/en\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/www.ana-martinez.com\/en\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.ana-martinez.com\/en\/wp-json\/wp\/v2\/comments?post=23"}],"version-history":[{"count":8,"href":"https:\/\/www.ana-martinez.com\/en\/wp-json\/wp\/v2\/pages\/23\/revisions"}],"predecessor-version":[{"id":966,"href":"https:\/\/www.ana-martinez.com\/en\/wp-json\/wp\/v2\/pages\/23\/revisions\/966"}],"wp:attachment":[{"href":"https:\/\/www.ana-martinez.com\/en\/wp-json\/wp\/v2\/media?parent=23"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":21,"date":"2014-07-29T07:19:44","date_gmt":"2014-07-29T07:19:44","guid":{"rendered":"http:\/\/www.ana-martinez.com\/en\/?page_id=21"},"modified":"2025-08-20T11:36:46","modified_gmt":"2025-08-20T09:36:46","slug":"biography","status":"publish","type":"page","link":"https:\/\/www.ana-martinez.com\/en\/biography\/","title":{"rendered":"BIOGRAPHY"},"content":{"rendered":"<p><a href=\"http:\/\/www.ana-martinez.com\/wp-content\/uploads\/2014\/07\/ana-martinez.jpg\"><br \/>\n<img loading=\"lazy\" decoding=\"async\" class=\"wp-image-50 size-medium alignleft\" src=\"http:\/\/www.ana-martinez.com\/wp-content\/uploads\/2014\/07\/ana-martinez-300x222.jpg\" alt=\"Ana Mart\u00ednez\" width=\"300\" height=\"222\" \/><\/a><\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>\n<p><a href=\"http:\/\/www.ana-martinez.com\/en\/wp-content\/uploads\/sites\/2\/2025\/08\/CV_Ana__Martinez.pdf\">CV_Ana__Mart\u00ednez<\/a> (download)<\/p>\n<p>BIO<\/p>\n<p>Ana Mart\u00ednez is an artist who lives and works in Spain.<\/p>\n<div dir=\"auto\">Graduated in Fine Arts from the Complutense University of Madrid, 1996, and furthered her studies at the Gerrit Rietveld Academie in Amsterdam, 1996\/97.<\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\">She has held solo and group exhibitions both in Spain and abroad.<\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\">In the early 1990s, she began creating installations in \u201cPunto de partida\u201d, a workshop taught by Soledad Sevilla and Chema Alvargonz\u00e1lez at the CAAC in Seville. During that decade, she also took part in the 10th edition of Circuitos de arte of the Community of Madrid, in a traveling exhibition organized by the Instituto Cervantes in cities such as Rome, Milan, Naples, Madrid, and Paris.<\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\">She has received creation grants from the Community of Madrid, the Provincial Council of C\u00f3rdoba, the Bot\u00ed Foundation in C\u00f3rdoba, the Regional Government of Andalusia, and the Regional Government of Castile and Le\u00f3n for the development of artistic projects.<\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\">She also participated in the 2nd edition of Arte de Mujeres by the Andalusian Women\u2019s Institute with a traveling exhibition through M\u00e1laga, Granada, and Seville.<\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\">She has taught INEM courses for the training and inclusion of unemployed women in the labor market, in Co\u00edn, M\u00e1laga.<\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\">She has conducted art workshops in Spain and the UK, on various themes and aimed at a wide range of ages.<\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\">She has taken part in group exhibitions in Spain and across different European countries, especially in the United Kingdom.<\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\">Solo exhibitions include: Galer\u00eda Carmen del Campo, C\u00f3rdoba; Sala Reyes Cat\u00f3licos, C\u00f3rdoba; Sala Tri\u00e1ngulo, Madrid; Sala La voz de mi madre, Salamanca; Iglesia de la Magdalena and Palacio de Viana, Fundaci\u00f3n Cajasur, C\u00f3rdoba; Sala Limbo 0, C\u00f3rdoba; Sala Galatea at Casa G\u00f3ngora, City Council of C\u00f3rdoba; Fundaci\u00f3n Rafael Bot\u00ed, C\u00f3rdoba; Fundaci\u00f3n Jos\u00e9 Luis Garc\u00eda Palacios of Caja Rural del Sur, Seville, as well as the same Foundation in its C\u00f3rdoba venue.<\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\">For more than 15 years, she has created commissioned murals of various formats in public and private spaces. She has painted murals in countries such as Spain, the United Kingdom, Argentina, and Cameroon.<\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\">She is currently focused on oil painting.<\/div>\n","protected":false},"excerpt":{"rendered":"<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; CV_Ana__Mart\u00ednez (download) BIO Ana Mart\u00ednez is an artist who lives and works in Spain. Graduated in Fine Arts from the Complutense University of Madrid, 1996, and furthered her studies at the Gerrit Rietveld Academie in Amsterdam, 1996\/97. She has held solo and group exhibitions both in Spain and abroad. [&hellip;]<\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"open","template":"","meta":{"_monsterinsights_skip_tracking":false,"footnotes":""},"_links":{"self":[{"href":"https:\/\/www.ana-martinez.com\/en\/wp-json\/wp\/v2\/pages\/21"}],"collection":[{"href":"https:\/\/www.ana-martinez.com\/en\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/www.ana-martinez.com\/en\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/www.ana-martinez.com\/en\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.ana-martinez.com\/en\/wp-json\/wp\/v2\/comments?post=21"}],"version-history":[{"count":10,"href":"https:\/\/www.ana-martinez.com\/en\/wp-json\/wp\/v2\/pages\/21\/revisions"}],"predecessor-version":[{"id":964,"href":"https:\/\/www.ana-martinez.com\/en\/wp-json\/wp\/v2\/pages\/21\/revisions\/964"}],"wp:attachment":[{"href":"https:\/\/www.ana-martinez.com\/en\/wp-json\/wp\/v2\/media?parent=21"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":19,"date":"2014-07-29T07:17:54","date_gmt":"2014-07-29T07:17:54","guid":{"rendered":"http:\/\/www.ana-martinez.com\/en\/?page_id=19"},"modified":"2019-06-27T11:00:37","modified_gmt":"2019-06-27T11:00:37","slug":"workshops","status":"publish","type":"page","link":"https:\/\/www.ana-martinez.com\/en\/workshops\/","title":{"rendered":"WORKSHOPS"},"content":{"rendered":"<div class='nlposts-container nlposts-block-container nlp-instance-default-716681664'><div class='nlposts-wrapper nlposts-block content'><div class='nlposts-block-item nlposts-siteid-2'><ul class='nlposts-block-thumbnail thumbnails'><li class='nlposts-block-thumbnail-litem